# Postgres connection string.
# Local dev (docker-compose): postgresql://globetrotter:globetrotter_dev@localhost:5434/globetrotter
# Neon (production): copy the pooled connection string from the Neon dashboard
# and append ?sslmode=require — no code changes needed, just swap this value.
DATABASE_URL=postgresql://globetrotter:globetrotter_dev@localhost:5434/globetrotter

# Better Auth secret (generate: openssl rand -base64 32)
BETTER_AUTH_SECRET=replace-me-with-a-random-secret
