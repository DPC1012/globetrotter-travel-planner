# Postgres connection (docker-compose.yml maps host port 5434)
DATABASE_URL=postgres://globetrotter:globetrotter_dev@127.0.0.1:5434/globetrotter

# Required. Generate one: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional: comma-separated origins allowed to call the auth API,
# e.g. when the frontend runs on a different port than this app.
# BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
